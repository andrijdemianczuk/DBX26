# Databricks Apps runs a managed `npm install` during the build phase, BEFORE the
# app.yaml runtime env (NODE_ENV=production) applies. Without this, that build-phase
# install pulls the full devDependencies tree (vite/react/typescript) and OOM-crashes
# the memory-limited build host ("npm error Exit handler never called!").
#
# The frontend is pre-built locally into dist/ and shipped, so the host needs ONLY
# express at runtime. omit=dev forces every install here to skip devDependencies.
# (For a local frontend rebuild, override with: npm install --include=dev)
omit=dev
fund=false
audit=false
